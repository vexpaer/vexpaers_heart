(version 1)

# The ADS1294R uses a 0.8 mm-pitch, 0.4 mm-ball BGA.  This bounded rule keeps
# the rest of the board at 0.15 mm clearance while permitting a conventional
# 0.15 mm / 0.125 mm dog-bone escape inside the package shadow.
(rule "ADS1294R BGA escape"
  (condition "A.intersectsArea('ADS_BGA_ESCAPE') || B.intersectsArea('ADS_BGA_ESCAPE')")
  (constraint clearance (min 0.125mm))
  (constraint track_width (min 0.15mm))
  (constraint hole_size (min 0.20mm))
  (constraint via_diameter (min 0.40mm))
)

# The STM32WB QFN has 0.4 mm peripheral pitch.  Keep the 0.10 mm allowance
# confined to the immediate pad fanout; all long digital runs remain 0.18 mm.
# A 0.45/0.20 mm finished through-via and 0.20 mm copper-to-hole clearance
# support a conventional staggered dog-bone fanout without via-in-pad.
(rule "STM32WB QFN escape"
  (condition "A.intersectsArea('MCU_QFN_ESCAPE') || B.intersectsArea('MCU_QFN_ESCAPE')")
  (constraint clearance (min 0.10mm))
  (constraint hole_clearance (min 0.20mm))
  (constraint track_width (min 0.15mm))
  (constraint hole_size (min 0.20mm))
  (constraint via_diameter (min 0.45mm))
)
